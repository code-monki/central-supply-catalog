<header>
  <div class="row header-row-1">
    <div class="menu">
      <a href="#" class="sidenav-trigger" id="menu-button" data-target="slide-out" aria-label="Open navigation">
        <span class="icon icon-menu" aria-hidden="true"></span>
      </a>
    </div>

    <div class="site-logo">
      <a href="/">Central Supply Catalog</a>
    </div>

    <div class="cart" id='shopping-cart'>
      <a href="{{ '/shopping-cart' | url }}" aria-label="Shopping cart">
        <span class="icon icon-cart" aria-hidden="true"></span>
          <small class="badge" id="cart-badge">1</small>
      </a>
    </div>
  </div>

  <div class="row header-row-2">
    <div class="row-2-content">
      <button class="dept-btn" id="dept-btn">Departments</button>
      <div class="dept-dropdown" id="dept-dropdown">{% generateDeptList %}</div>
      <div class="search-form">
        <form>
          <label class="visually-hidden" for="search-input">Search catalog</label>
          <input type="text" name="search" class="search-input" id="search-input">
          <button class="search-btn" id="search-button" aria-label="Search catalog"><span class="icon icon-search" aria-hidden="true"></span></button>
        </form>
      </div>
    </div>
  </div>

</header>
