{
  "name": "central-supply-catalog",
  "version": "1.0.0",
  "description": "The Central Supply Catalog (CSC) provides an online catalog of equipment and supplies for the Cepheus Engine and Traveller Science Fiction Role-Playing Games (SFRPG). The catalog is a living resource and allows new entries to be submitted via pull requests. The CSC is hosted on Netlify and is a free resource for the community.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prod": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "editor": "node scripts/catalog-editor.mjs",
    "build:search-index": "node scripts/build-search-index.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "test": "npm run test:browser && npm run test:editor",
    "test:install": "playwright install chromium",
    "test:browser": "playwright test",
    "test:editor": "node --test tests/editor-api.node.mjs",
    "test:audit": "node scripts/lighthouse-budget.mjs",
    "astro:dev": "npm run dev",
    "astro:build": "npm run prod",
    "astro:preview": "npm run preview",
    "start": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmcknight/central-supply-catalog.git"
  },
  "keywords": [],
  "author": "Chuck McKnight",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cmcknight/central-supply-catalog/issues"
  },
  "homepage": "https://github.com/cmcknight/central-supply-catalog#readme",
  "devDependencies": {
    "@astrojs/vue": "^7.0.1",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "ajv": "^8.20.0",
    "astro": "^7.1.4",
    "lighthouse": "^13.4.1",
    "markdown-it": "^14.3.0",
    "slugify": "^1.6.5",
    "vue": "^3.5.40"
  }
}
