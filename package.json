{
  "name": "central-supply-catalog",
  "version": "1.0.0",
  "description": "The Central Supply Catalog (CSC) provides an online catalog of equipment and supplies for the Cepheus Engine and Traveller Science Fiction Role-Playing Games (SFRPG). The catalog is a living resource and allows new entries to be submitted via pull requests. The CSC is hosted on Netlify and is a free resource for the community.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prod": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "astro:dev": "npm run dev",
    "astro:build": "npm run prod",
    "astro:preview": "npm run preview",
    "eleventy:dev": "ELEVENTY_ENV=dev npx @11ty/eleventy --serve --output=build",
    "eleventy:prod": "ELEVENTY_ENV=prod npx @11ty/eleventy --output=eleventy-dist",
    "gen-search-index": "node ./src/util/search.js  ",
    "watch:eleventy": "npm run eleventy:dev",
    "start": "npm run dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cmcknight/central-supply-catalog.git"
  },
  "keywords": [],
  "author": "Chuck McKnight",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cmcknight/central-supply-catalog/issues"
  },
  "homepage": "https://github.com/cmcknight/central-supply-catalog#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-upgrade-help": "^3.0.2",
    "@astrojs/vue": "^7.0.1",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "astro": "^7.1.4",
    "del": "^8.0.1",
    "gulp": "^5.0.1",
    "gulp-autoprefixer": "^10.0.0",
    "gulp-babel": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-cli": "^3.1.0",
    "gulp-html-minifier-terser": "^8.0.0",
    "gulp-rename": "^2.0.0",
    "gulp-uglify": "^3.0.2",
    "markdown-it": "^14.3.0",
    "slugify": "^1.6.5",
    "vue": "^3.5.40"
  },
  "dependencies": {
    "minisearch": "^7.2.0"
  },
  "overrides": {
    "@11ty/recursive-copy": "^5.0.2"
  }
}
