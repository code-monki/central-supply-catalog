---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchResults from '../../components/SearchResults.vue';
import { readMarkdownPage, searchDocuments } from '../../lib/catalog.js';
import noImage from '../../../src/img/products/no-image.png';

const page = readMarkdownPage('src/pages/search.md');
const documents = searchDocuments();
---

<BaseLayout title={`${page.data.title} | Central Supply Catalog`} pageClass="site-page">
  <main id="main">
    <div class="site-page-content">
      <h1>{page.data.title}</h1>
      <div class="search-results-slot">
        <SearchResults documents={documents} fallbackImage={noImage.src} client:load />
      </div>
      <Fragment set:html={page.html} />
    </div>
  </main>
</BaseLayout>
