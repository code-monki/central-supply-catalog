---
import BaseLayout from '../layouts/BaseLayout.astro';
import { allProducts, departmentMenu, getProductsForCategory } from '../lib/catalog.mjs';
import { withBase } from '../lib/paths.mjs';

const departments = departmentMenu().map((department) => ({
  ...department,
  href: withBase(department.href),
  departments: department.departments.map((subDepartment) => ({
    ...subDepartment,
    href: withBase(subDepartment.href),
  })),
  productCount: getProductsForCategory(department.label).length,
}));
const productCount = allProducts().length;
const departmentCount = departments.length;
---

<BaseLayout title="Central Supply Catalog">
  <main id="main" class="content-container home-content" tabindex="0" aria-label="Catalog home">
    <dl class="catalog-stats" aria-label="Catalog summary">
      <div>
        <dt>Products</dt>
        <dd>{productCount}</dd>
      </div>
      <div>
        <dt>Departments</dt>
        <dd>{departmentCount}</dd>
      </div>
    </dl>

    <section class="home-departments" aria-labelledby="home-departments-title">
      <h2 id="home-departments-title">Departments</h2>
      <div class="home-department-grid">
        {departments.map((department) => (
          <article class="home-department-card">
            <div class="home-department-card-header">
              <a class="home-department-main-link" href={department.href}>{department.label}</a>
              <small>{department.productCount} products</small>
            </div>
            {department.departments.length > 0 && (
              <div class="home-subdepartment-links" aria-label={`${department.label} sub-departments`}>
                {department.departments.map((subDepartment) => (
                  <a href={subDepartment.href}>{subDepartment.label}</a>
                ))}
              </div>
            )}
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
