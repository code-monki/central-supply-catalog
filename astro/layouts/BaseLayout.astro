---
import SiteHeader from '../components/SiteHeader.vue';
import { departmentMenu, searchIndexVersion } from '../lib/catalog.mjs';
import { withBase } from '../lib/paths.mjs';
import '../../src/css/main.css';
import favicon from '../../src/img/favicons/favicon.png';

const { title = 'Central Supply Catalog', pageClass = 'page-container' } = Astro.props;
const menu = departmentMenu().map((category) => ({
  ...category,
  href: withBase(category.href),
  departments: category.departments.map((department) => ({
    ...department,
    href: withBase(department.href),
  })),
}));
const indexVersion = searchIndexVersion();
const searchIndexUrl = withBase('/_data/searchindex.json');
const serviceWorkerUrl = withBase('/sw.js');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Equipment and supplies catalog for Cepheus Engine and Traveller science fiction role-playing games.">
    <link rel="icon" href={favicon.src} type="image/x-icon">
    <title>{title}</title>
  </head>
  <body>
    <div class="overlay"></div>
    <div class={pageClass}>
      <SiteHeader menu={menu} searchIndexUrl={searchIndexUrl} searchIndexVersion={indexVersion} baseUrl={import.meta.env.BASE_URL} client:load />
      <slot />
      <footer>
        <div class="copyright-info">
          <a href={withBase('/about-the-central-supply-catalog/#disclaimers')}>
            Code and content licensing details
          </a>.
        </div>
      </footer>
    </div>
    <script define:vars={{ serviceWorkerUrl }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(serviceWorkerUrl).catch(() => {});
        });
      }
    </script>
  </body>
</html>
